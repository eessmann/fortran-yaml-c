@PACKAGE_INIT@

set(fortran_yaml_download_yaml @DOWNLOAD_LIBYAML@)

include("${CMAKE_CURRENT_LIST_DIR}/fortran-yaml-c-targets.cmake")

if(NOT fortran_yaml_download_yaml)
    find_dependency(PkgConfig)
    pkg_check_modules(YAML REQUIRED IMPORTED_TARGET yaml-0.1)
    set_target_properties(fortran_yaml::yaml_interface PROPERTIES INTERFACE_LINK_LIBRARIES PkgConfig::YAML)
endif ()

unset(fortran_yaml_download_yaml)